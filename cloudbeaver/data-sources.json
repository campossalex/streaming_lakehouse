{
  "folders": {},
  "connections": {
    "trino-lakehouse": {
      "provider": "generic",
      "driver": "trino_jdbc",
      "name": "Trino — Lakehouse",
      "description": "Iceberg tables tiered by Fluss, catalogued by Lakekeeper. Query them as lakehouse.orders.*",
      "save-password": true,
      "show-system-objects": false,
      "configuration": {
        "host": "trino",
        "port": "8080",
        "database": "lakehouse",
        "url": "jdbc:trino://trino:8080/lakehouse",
        "configurationType": "MANUAL",
        "type": "dev",
        "auth-model": "native",
        "auth-properties": {
          "user": "workshop"
        }
      }
    },
    "postgres-shop": {
      "provider": "postgresql",
      "driver": "postgres-jdbc",
      "name": "PostgreSQL — shop",
      "description": "The shop's source database: product_catalog, read by the CDC source. Edit a product and watch the change reach product_lookup.",
      "save-password": true,
      "show-system-objects": false,
      "configuration": {
        "host": "postgres",
        "port": "5432",
        "database": "shop",
        "url": "jdbc:postgresql://postgres:5432/shop",
        "configurationType": "MANUAL",
        "type": "dev",
        "auth-model": "native",
        "user": "shop_user",
        "password": "admin1",
        "auth-properties": {
          "user": "shop_user",
          "password": "admin1"
        }
      }
    },
    "postgres-dwh": {
      "provider": "postgresql",
      "driver": "postgres-jdbc",
      "name": "PostgreSQL — dwh",
      "description": "The data warehouse: revenue_1m, written by revenue-analytics-sink and read by Grafana.",
      "save-password": true,
      "show-system-objects": false,
      "configuration": {
        "host": "postgres-dwh",
        "port": "5432",
        "database": "dwh",
        "url": "jdbc:postgresql://postgres-dwh:5432/dwh",
        "configurationType": "MANUAL",
        "type": "dev",
        "auth-model": "native",
        "user": "dwh_user",
        "password": "admin1",
        "auth-properties": {
          "user": "dwh_user",
          "password": "admin1"
        }
      }
    }
  }
}
