          "rawQuery": true,
          "rawSql": "SELECT\n  category                                                   AS \"Category\",\n  SUM(order_count)                                           AS \"Orders\",\n  SUM(revenue)                                               AS \"Revenue\",\n  SUM(revenue) / NULLIF(SUM(order_count), 0)                 AS \"Avg order\",\n  MAX(max_order_value)                                       AS \"Max order\",\n  AVG(avg_unit_price)                                        AS \"Avg price\",\n  SUM(paid_count)                                            AS \"Paid\",\n  SUM(shipped_count)                                         AS \"Shipped\",\n  SUM(delivered_count)                                       AS \"Delivered\",\n  SUM(cancelled_count)                                       AS \"Cancelled\",\n  SUM(cancelled_count)::numeric / NULLIF(SUM(order_count), 0) AS \"Cancel rate\",\n  SUM(delivered_revenue)                                     AS \"Delivered $\",\n  SUM(cancelled_revenue)                                     AS \"Cancelled $\",\n  SUM(event_count)                                           AS \"Events\"\nFROM revenue_5m\nWHERE $__timeFilter(window_start)\nGROUP BY category\nORDER BY \"Revenue\" DESC",
